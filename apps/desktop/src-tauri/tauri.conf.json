{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tamishra Workspace",
  "version": "0.1.0",
  "identifier": "in.tamishra.workspace",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev:web:native",
    "beforeBuildCommand": "npm --prefix ../.. run build:web:native",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tamishra Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https: wss:; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; media-src 'self' blob: https:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Productivity",
    "shortDescription": "Tamishra productivity and collaboration workspace",
    "longDescription": "Tamishra Workspace brings documents, spreadsheets, presentations, PDF, chat, mail, meetings, notes, forms and files into one productivity environment.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "tmsl"
        ],
        "name": "Tamishra Slides Presentation",
        "description": "Tamishra Slides native presentation",
        "mimeType": "application/x-tamishra-slides",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "in.tamishra.slides.tmsl",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ]
  }
}
