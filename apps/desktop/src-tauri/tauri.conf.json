{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tamishra Workspace",
  "version": "0.1.0",
  "identifier": "in.tamishra.workspace",
  "build": {
    "beforeDevCommand": "npm --prefix ../../.. run dev:web",
    "beforeBuildCommand": "npm --prefix ../../.. run build:web",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tamishra Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "Tamishra productivity and collaboration workspace",
    "longDescription": "Tamishra Workspace brings documents, spreadsheets, presentations, PDF, chat, mail, meetings, notes, forms and files into one productivity environment."
  }
}
