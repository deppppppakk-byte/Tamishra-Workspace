# Kosh online-native gateway profile
# Durable repository state lives in PostgreSQL snapshots. The filesystem is a
# disposable cache and may be erased whenever the runtime is replaced.

NODE_ENV=production
WORKSPACE_CORE_ONLY=true

# Online hosts normally inject PORT. Kosh listens to PORT automatically when
# WORKSPACE_GATEWAY_PORT is not set.
PORT=8000

WORKSPACE_DATABASE_URL=CHANGE_ME_DATABASE_URL
WORKSPACE_ALLOWED_ORIGINS=https://tamishra.in,https://www.tamishra.in,https://kosh.tamishra.in
WORKSPACE_IP_HASH_SECRET=CHANGE_ME_32_PLUS_CHAR_SECRET
WORKSPACE_SESSION_COOKIE_SECURE=true
WORKSPACE_SESSION_COOKIE_PATH=/api/workspace
WORKSPACE_TRUST_PROXY=true

KOSH_PUBLIC_ORIGIN=https://tamishra.in/kosh
KOSH_REPO_PERSISTENCE=postgres
KOSH_REPO_AUTHORITY=online
KOSH_REPO_SNAPSHOT_MAX_MB=512

# Kosh Cloud controller and first-party reverse relay. Multiple controller
# instances share a PostgreSQL-backed heartbeat and automatic leader lease.
KOSH_CLOUD_ENABLED=true
KOSH_CLOUD_NODE_ENROLLMENT_SECRET=CHANGE_ME_32_PLUS_CHAR_SECRET
KOSH_CLOUD_RELAY_MAX_BODY_MB=8
KOSH_CLOUD_RELAY_TIMEOUT_MS=30000
KOSH_CONTROLLER_HEARTBEAT_MS=15000
KOSH_CONTROLLER_LEASE_SECONDS=45

# Kosh Deploy stable app domains. One wildcard DNS record for *.apps.tamishra.in
# can route every browser-deployed service to the Kosh gateway. Mark edge/TLS
# ready only after the public edge is actually serving that wildcard securely.
KOSH_DEPLOY_BASE_DOMAIN=apps.tamishra.in
KOSH_DEPLOY_PUBLIC_SCHEME=https
KOSH_DEPLOY_EDGE_READY=false
KOSH_DEPLOY_TLS_MANAGED=false

# Linux/container runtime cache. Losing this directory must not lose repository
# data because each repository is reconstructed from the online snapshot.
KOSH_REPO_ROOT=/tmp/kosh/repos

KOSH_BOOTSTRAP_REPOSITORIES=tamishra/kavyn-2d,tamishra/os
KOSH_BOOTSTRAP_SINGLE_OWNER_FALLBACK=true
KOSH_GIT_TOKEN=CHANGE_ME_24_PLUS_CHAR_SECRET
KOSH_RUNNER_TOKEN=CHANGE_ME_24_PLUS_CHAR_SECRET

# Browser-only managed build pool. Kosh queues builds when capacity is busy,
# continuously requeues expired leases, and targets only the required runner release.
KOSH_MANAGED_WINDOWS_BUILD_MIN=1
KOSH_MANAGED_ANDROID_BUILD_MIN=1
KOSH_RUNNER_REQUIRED_VERSION=0.3.0
KOSH_MANAGED_BUILD_RECONCILE_ENABLED=true
KOSH_MANAGED_BUILD_RECONCILE_MS=30000
KOSH_RUNNER_ALLOW_HOST_EXECUTION=true
KOSH_RUNNER_ALLOW_NETWORK=true
KOSH_PACKAGE_MAX_MB=512

# Browser-driven Git import accepts only approved HTTPS source hosts. Private
# source credentials are referenced by Kosh Secret name and never sent inline.
KOSH_GIT_IMPORT_ALLOWED_HOSTS=github.com

KOSH_NATIVE_STORAGE_SELFTEST=false
