# Kosh production operations queue
WORKSPACE_DATABASE_URL=
KOSH_OPS_LEASE_SECONDS=120
KOSH_OPS_POLL_MS=1500
KOSH_OPS_WORKER_CONCURRENCY=2
# Admission/backpressure limits for queued operations across the platform and per repository/platform scope.
KOSH_OPS_MAX_QUEUED=10000
KOSH_OPS_MAX_REPOSITORY_QUEUED=1000
# Worker-fleet evidence. Heartbeats should be comfortably more frequent than the stale threshold.
KOSH_OPS_WORKER_HEARTBEAT_SECONDS=15
KOSH_OPS_WORKER_STALE_SECONDS=90
# Scheduler candidacy. Multiple workers may set this true; PostgreSQL elects one renewable leader.
KOSH_OPS_SCHEDULER=false
KOSH_OPS_SCHEDULER_POLL_MS=60000
KOSH_OPS_SCHEDULER_LEASE_SECONDS=120
KOSH_OPS_WORKER_ID=

# Provider-neutral worker-capacity recommendations and optional automatic scaler handoff.
KOSH_OPS_AUTOSCALE_ENABLED=false
KOSH_OPS_AUTOSCALE_MIN_WORKERS=1
KOSH_OPS_AUTOSCALE_MAX_WORKERS=20
KOSH_OPS_AUTOSCALE_TARGET_QUEUED_PER_SLOT=2
KOSH_OPS_AUTOSCALE_ASSUMED_CONCURRENCY=2
KOSH_OPS_AUTOSCALE_SCALE_DOWN_IDLE_SLOTS=4
KOSH_OPS_AUTOSCALE_COOLDOWN_SECONDS=180
KOSH_OPS_AUTOSCALE_SCALE_DOWN_STABILIZATION_SECONDS=600
# Trusted deployment scaler endpoint. In production it must use HTTPS and a bearer token.
KOSH_OPS_SCALER_URL=
KOSH_OPS_SCALER_TOKEN=

# Object storage primary + optional verified local mirror/failover.
KOSH_OBJECT_STORAGE_BACKEND=google-drive
KOSH_OBJECT_MIRROR_ROOT=/var/lib/kosh/object-mirror
# Set true only when every object write must have both primary and mirror copies.
KOSH_OBJECT_MIRROR_REQUIRED=false

# Google Drive runtime credentials/folders (deployment secrets, never commit live values).
KOSH_GOOGLE_DRIVE_CLIENT_ID=
KOSH_GOOGLE_DRIVE_CLIENT_SECRET=
KOSH_GOOGLE_DRIVE_REFRESH_TOKEN=
KOSH_GOOGLE_DRIVE_ROOT_FOLDER_ID=
KOSH_GOOGLE_DRIVE_PACKAGES_FOLDER_ID=
KOSH_GOOGLE_DRIVE_RELEASES_FOLDER_ID=
KOSH_GOOGLE_DRIVE_ARTIFACTS_FOLDER_ID=
KOSH_GOOGLE_DRIVE_BACKUPS_FOLDER_ID=
KOSH_GOOGLE_DRIVE_TIMEOUT_MS=120000
KOSH_GOOGLE_DRIVE_CHUNK_MB=8

# Notification relay. The relay is responsible for email/push/mobile provider delivery.
KOSH_NOTIFICATION_DELIVERY_ENDPOINT=
KOSH_NOTIFICATION_DELIVERY_TOKEN=

# Pages custom-domain certificate/DNS edge provisioner.
KOSH_PAGES_TLS_PROVISIONER_URL=
KOSH_PAGES_TLS_PROVISIONER_TOKEN=

# Extension execution adapter. Example:
# KOSH_EXTENSION_SANDBOX_COMMAND=/usr/bin/node
# When using node directly, deploy a wrapper command that invokes scripts/kosh-extension-sandbox.mjs.
KOSH_EXTENSION_SANDBOX_COMMAND=
KOSH_EXTENSION_SANDBOX_IMAGE=
KOSH_EXTENSION_MAX_MEMORY_MB=256
KOSH_EXTENSION_MAX_CPU=1
KOSH_EXTENSION_MAX_PIDS=128
KOSH_EXTENSION_ALLOW_NETWORK=false
KOSH_DOCKER_BIN=docker

# Load/failure probes.
KOSH_PUBLIC_ORIGIN=https://kosh.tamishra.in
# Destructive production faults are not implemented; this only enables bounded synthetic probes.
KOSH_ALLOW_PRODUCTION_FAILURE_PROBES=false

# PostgreSQL backup tool. pg_dump must be present in the worker image.
KOSH_PG_DUMP_BIN=pg_dump
KOSH_BACKUP_ROOT=/var/lib/kosh/backups
# Number of verified PostgreSQL backup objects retained after successful backup jobs.
KOSH_DATABASE_BACKUP_RETENTION=14

# Repository/service production secrets already required elsewhere.
KOSH_MASTER_KEY=
KOSH_RUNNER_TOKEN=
KOSH_GIT_TOKEN=
KOSH_PLATFORM_ADMIN_USER_IDS=
