{
  "name": "tamishra-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Tamishra productivity and collaboration workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/web run start",
    "lint": "npm --workspace apps/web run lint"
  },
  "engines": {
    "node": ">=22"
  }
}
