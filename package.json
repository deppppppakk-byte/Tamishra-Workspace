{
  "name": "tamishra-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Tamishra productivity and collaboration workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @tamishra/web",
    "dev:gateway": "npm run dev --workspace @tamishra/gateway",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace @tamishra/web",
    "build:gateway": "npm run build --workspace @tamishra/gateway",
    "check:web": "npm run check --workspace @tamishra/web",
    "check:gateway": "npm run check --workspace @tamishra/gateway",
    "check:meet": "npm run check:gateway && npm run check:web",
    "desktop:dev": "npm run tauri:dev --workspace @tamishra/desktop",
    "desktop:build": "npm run tauri:build --workspace @tamishra/desktop",
    "mobile:sync": "npm run sync --workspace @tamishra/mobile",
    "mobile:add:android": "npm run android:add --workspace @tamishra/mobile",
    "mobile:add:ios": "npm run ios:add --workspace @tamishra/mobile"
  },
  "engines": {
    "node": ">=22"
  }
}
