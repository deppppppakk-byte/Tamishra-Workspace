{
  "name": "tamishra-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Tamishra productivity and collaboration workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "node scripts/run-web.mjs dev hosted",
    "dev:gateway": "npm run dev --workspace @tamishra/gateway",
    "build": "npm run build:web",
    "build:web": "node scripts/run-web.mjs build hosted",
    "build:gateway": "npm run build:runtime-packages && npm run build --workspace @tamishra/gateway",
    "kosh:node:build": "npm run build:gateway",
    "kosh:node:start": "node --env-file=.env.kosh-node apps/gateway/dist/index.js",
    "check:web": "npm run check --workspace @tamishra/web",
    "check:gateway": "npm run check:runtime-packages && npm run check --workspace @tamishra/gateway",
    "check:meet": "npm run check:gateway && npm run check:web",
    "desktop:dev": "npm run tauri:dev --workspace @tamishra/desktop",
    "desktop:build": "npm run tauri:build --workspace @tamishra/desktop",
    "mobile:sync": "npm run sync --workspace @tamishra/mobile",
    "mobile:add:android": "npm run android:add --workspace @tamishra/mobile",
    "mobile:add:ios": "npm run ios:add --workspace @tamishra/mobile",
    "kosh:mobile:sync": "npm run sync --workspace @tamishra/kosh-mobile",
    "kosh:mobile:add:android": "npm run android:add --workspace @tamishra/kosh-mobile",
    "kosh:mobile:add:ios": "npm run ios:add --workspace @tamishra/kosh-mobile",
    "start:kosh-plugin": "npm run start --workspace @tamishra/kosh-plugin",
    "check:kosh-plugin": "npm run check --workspace @tamishra/kosh-plugin",
    "dev:web:native": "node scripts/run-web.mjs dev native",
    "build:web:native": "node scripts/run-web.mjs build native",
    "build:hosted": "npm run build:web && npm run build:gateway",
    "check": "npm run check:provider-independence && npm run check:kosh-systems && npm run check:chat-core && npm run check:sheets && npm run test:sheets && npm run check:web && npm run check:gateway && npm run check:kosh-runner && npm run check:kosh-cli && npm run check:kosh-ssh && npm run check:kosh-plugin && npm run check:patra-mailer",
    "dev:patra-mailer": "npm run dev --workspace @tamishra/patra-mailer",
    "start:patra-mailer": "npm run start --workspace @tamishra/patra-mailer",
    "check:patra-mailer": "npm run check --workspace @tamishra/patra-mailer",
    "dev:web:patra": "node scripts/run-web.mjs dev patra",
    "build:web:patra": "node scripts/run-web.mjs build patra",
    "build:runtime-packages": "npm run build --workspace @tamishra/identity && npm run build --workspace @tamishra/permissions",
    "check:runtime-packages": "npm run check --workspace @tamishra/identity && npm run check --workspace @tamishra/permissions",
    "production:check": "npm run check && npm audit --omit=dev --audit-level=high",
    "start:gateway": "npm run start --workspace @tamishra/gateway",
    "check:sheets": "npm run check --workspace @tamishra/sheets-engine",
    "test:sheets": "npm run test --workspace @tamishra/sheets-engine",
    "check:chat-core": "npm run check --workspace @tamishra/chat-core",
    "test:patra-smoke": "npm run build:gateway && node scripts/patra-smoke.mjs",
    "check:provider-independence": "node scripts/assert-provider-independence.mjs",
    "check:kosh-systems": "node scripts/assert-kosh-systems.mjs",
    "build:kosh-runner": "npm run build --workspace @tamishra/kosh-runner",
    "check:kosh-runner": "npm run check --workspace @tamishra/kosh-runner",
    "build:kosh-cli": "npm run build --workspace @tamishra/kosh-cli",
    "check:kosh-cli": "npm run check --workspace @tamishra/kosh-cli",
    "build:kosh-ssh": "npm run build --workspace @tamishra/kosh-ssh",
    "check:kosh-ssh": "npm run check --workspace @tamishra/kosh-ssh"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    },
    "baseline-browser-mapping": "2.11.26"
  }
}
