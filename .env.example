# Hosted Tamishra Workspace path
WORKSPACE_BASE_PATH=/workspace
NEXT_PUBLIC_WORKSPACE_API_BASE=/api/workspace
WORKSPACE_NATIVE_API_BASE=https://tamishra.in/api/workspace

# Tamishra Workspace web
NEXT_PUBLIC_WORKSPACE_GATEWAY_ORIGIN=http://localhost:4100

# Workspace gateway
WORKSPACE_GATEWAY_PORT=4100
WORKSPACE_WEB_ORIGIN=http://localhost:3000
# Production: https://tamishra.in
WORKSPACE_ALLOWED_ORIGINS=http://localhost:3000,https://tamishra.in,http://tauri.localhost,tauri://localhost,https://localhost,capacitor://localhost

# Workspace identity/session security
WORKSPACE_SESSION_COOKIE_NAME=tamishra_workspace_session
# Hosted production requests enter through /api/workspace.
WORKSPACE_SESSION_COOKIE_PATH=/api/workspace
WORKSPACE_SESSION_COOKIE_SECURE=true
WORKSPACE_TRUST_PROXY=true
# Set to a long random secret in production to privacy-hash client IP metadata.
WORKSPACE_IP_HASH_SECRET=change-me-to-a-long-random-secret

# Workspace database
# Primary database for Identity, Meet and future Workspace services.
WORKSPACE_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Legacy/specialized override. Leave empty to use WORKSPACE_DATABASE_URL.
WORKSPACE_MEET_DATABASE_URL=

# Workspace-owned LiveKit deployment
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me


# Tamishra Meet recording storage
# Any S3-compatible object store can be used.
WORKSPACE_MEET_RECORDING_BUCKET=
WORKSPACE_MEET_RECORDING_REGION=
WORKSPACE_MEET_RECORDING_ENDPOINT=
WORKSPACE_MEET_RECORDING_ACCESS_KEY=
WORKSPACE_MEET_RECORDING_SECRET=
WORKSPACE_MEET_RECORDING_FORCE_PATH_STYLE=true
WORKSPACE_MEET_RECORDING_PREFIX=tamishra-meet

# Vendor independence
# Do not add Google or Microsoft API keys, OAuth clients, Gmail/Outlook/Graph,
# Drive/OneDrive, Meet/Teams, or Office/Google Workspace runtime dependencies.
