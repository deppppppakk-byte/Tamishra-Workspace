# Hosted Tamishra Workspace path
WORKSPACE_BASE_PATH=/workspace
NEXT_PUBLIC_WORKSPACE_API_BASE=/api/workspace
WORKSPACE_NATIVE_API_BASE=https://tamishra.in/api/workspace

# Tamishra Workspace web
NEXT_PUBLIC_WORKSPACE_GATEWAY_ORIGIN=http://localhost:4100

# Workspace gateway
WORKSPACE_GATEWAY_PORT=4100
WORKSPACE_WEB_ORIGIN=http://localhost:3000
# Production: https://tamishra.in
WORKSPACE_ALLOWED_ORIGINS=http://localhost:3000,https://tamishra.in,https://patra.tamishra.in,https://kosh.tamishra.in,http://tauri.localhost,tauri://localhost,https://localhost,capacitor://localhost

# Workspace identity/session security
WORKSPACE_SESSION_COOKIE_NAME=tamishra_workspace_session
# Hosted production requests enter through /api/workspace.
WORKSPACE_SESSION_COOKIE_PATH=/api/workspace
WORKSPACE_SESSION_COOKIE_SECURE=true
WORKSPACE_TRUST_PROXY=true
# Set to a long random secret in production to privacy-hash client IP metadata.
WORKSPACE_IP_HASH_SECRET=change-me-to-a-long-random-secret

# Workspace database
# Provider-neutral PostgreSQL for Identity, Patra, Chat, Docs, Files and Meet.
# On Supabase + Render, use the Shared Pooler Session-mode URL (port 5432).
# Server-side secret only. Never expose through NEXT_PUBLIC_* variables.
WORKSPACE_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Legacy/specialized override. Leave empty to use WORKSPACE_DATABASE_URL.
WORKSPACE_MEET_DATABASE_URL=

\n# Kosh — Tamishra development platform\n# Must point to persistent disk in production. Live Git repositories should not be placed in Google Drive.\nKOSH_REPO_ROOT=.kosh/repos\nKOSH_PUBLIC_ORIGIN=http://localhost:4100\n# Required for production Git pushes. Store only on the gateway.\nKOSH_GIT_TOKEN=change-me-to-a-long-random-secret\n\n# Workspace-owned LiveKit deployment
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me


# Tamishra Meet recording storage
# Any S3-compatible object store can be used.
WORKSPACE_MEET_RECORDING_BUCKET=
WORKSPACE_MEET_RECORDING_REGION=
WORKSPACE_MEET_RECORDING_ENDPOINT=
WORKSPACE_MEET_RECORDING_ACCESS_KEY=
WORKSPACE_MEET_RECORDING_SECRET=
WORKSPACE_MEET_RECORDING_FORCE_PATH_STYLE=true
WORKSPACE_MEET_RECORDING_PREFIX=tamishra-meet


# Tamishra Meet live captions/transcription
# Explicit LiveKit agent dispatch target. Leave blank to disable live captions.
WORKSPACE_MEET_TRANSCRIBER_AGENT=
# Shared only between the Workspace gateway and the transcriber worker.
WORKSPACE_MEET_TRANSCRIBER_SECRET=
WORKSPACE_MEET_TRANSCRIBER_MODEL=tamishra-default
WORKSPACE_MEET_TRANSCRIBER_LANGUAGE=multi

# Optional Tamishra-controlled meeting summarizer.
# If unset/unavailable, Workspace uses its built-in extractive summary fallback.
WORKSPACE_MEET_SUMMARY_ENDPOINT=
WORKSPACE_MEET_SUMMARY_SECRET=

# Vendor independence
# Do not add Google or Microsoft API keys, OAuth clients, Gmail/Outlook/Graph,
# Drive/OneDrive, Meet/Teams, or Office/Google Workspace runtime dependencies.

# Tamishra Patra public product
PATRA_PUBLIC_ORIGIN=https://patra.tamishra.in
PATRA_MAIL_DOMAIN=patra.tamishra.in
PATRA_COMPANY_MAIL_DOMAIN=tamishra.in
# Required for protected @tamishra.in mailbox provisioning. Never expose to clients.
PATRA_COMPANY_PROVISIONING_SECRET=change-me-to-a-long-random-admin-secret
# Recommended public Patra API entrypoint, reverse-proxied to the Workspace gateway.
PATRA_API_ORIGIN=https://api.patra.tamishra.in

# Patra Mailer — inbound SMTP
PATRA_SMTP_HOSTNAME=mx.patra.tamishra.in
PATRA_SMTP_LISTEN_HOST=0.0.0.0
PATRA_SMTP_LISTEN_PORT=2525
PATRA_HEALTH_PORT=4201
PATRA_SMTP_MAX_MESSAGE_BYTES=26214400
PATRA_SMTP_MAX_CLIENTS=100
PATRA_SMTP_SOCKET_TIMEOUT_MS=60000
# PEM values may use literal \n sequences in environment variables.
PATRA_SMTP_TLS_KEY=
PATRA_SMTP_TLS_CERT=

# Patra Mailer — outbound delivery through a Tamishra-controlled SMTP MTA/relay
PATRA_SMTP_RELAY_HOST=
PATRA_SMTP_RELAY_PORT=587
PATRA_SMTP_RELAY_SECURE=false
PATRA_SMTP_RELAY_REQUIRE_TLS=true
PATRA_SMTP_RELAY_USER=
PATRA_SMTP_RELAY_PASSWORD=
PATRA_SMTP_RELAY_CONNECTIONS=5
PATRA_SMTP_RELAY_MAX_MESSAGES=100
PATRA_DELIVERY_POLL_MS=5000
PATRA_DELIVERY_MAX_ATTEMPTS=5

# Patra DKIM signing
PATRA_DKIM_SELECTOR=patra1
PATRA_DKIM_PRIVATE_KEY=
