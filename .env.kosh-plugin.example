# Kosh MCP public process
NODE_ENV=production
KOSH_PLUGIN_PORT=4310
KOSH_ORIGIN=https://kosh.tamishra.in
KOSH_PLUGIN_PUBLIC_ORIGIN=https://kosh.tamishra.in
KOSH_OAUTH_ISSUER=https://kosh.tamishra.in
KOSH_PLUGIN_ASSERTION_SECRET=change-me-to-a-random-secret-at-least-32-characters

# Kosh Gateway OAuth configuration
# WORKSPACE_DATABASE_URL is also required for persistent OAuth clients/codes/tokens.
KOSH_OAUTH_RESOURCES=https://kosh.tamishra.in/mcp
KOSH_OAUTH_LOGIN_URL=https://kosh.tamishra.in/login
KOSH_OAUTH_CONSENT_SECRET=change-me-to-a-separate-random-secret-at-least-32-characters
KOSH_OAUTH_ACCESS_TOKEN_MINUTES=60
KOSH_OAUTH_REFRESH_TOKEN_DAYS=30
KOSH_OAUTH_CODE_SECONDS=600

# Development only. Never set this on the public MCP deployment.
# KOSH_PLUGIN_TOKEN=kosh_pat_...
