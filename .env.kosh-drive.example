# Kosh object storage backend
KOSH_OBJECT_STORAGE_BACKEND=google-drive

# Runtime OAuth credentials. Keep these only in deployment secrets.
KOSH_GOOGLE_DRIVE_CLIENT_ID=
KOSH_GOOGLE_DRIVE_CLIENT_SECRET=
KOSH_GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional short-lived development alternative to refresh-token auth.
KOSH_GOOGLE_DRIVE_ACCESS_TOKEN=

# Google Drive folder IDs. Class-specific folders are preferred.
KOSH_GOOGLE_DRIVE_ROOT_FOLDER_ID=
KOSH_GOOGLE_DRIVE_PACKAGES_FOLDER_ID=
KOSH_GOOGLE_DRIVE_RELEASES_FOLDER_ID=
KOSH_GOOGLE_DRIVE_ARTIFACTS_FOLDER_ID=
KOSH_GOOGLE_DRIVE_BACKUPS_FOLDER_ID=
KOSH_GOOGLE_DRIVE_TIMEOUT_MS=120000
# Resumable transfer chunk size for large recovery bundles.
KOSH_GOOGLE_DRIVE_CHUNK_MB=8

# Recovery bundle object limit. Existing default is 2048 MiB.
KOSH_BACKUP_MAX_MB=2048

# Temporary workspace used only while verifying migrated Drive objects.
# Put this on local ephemeral/persistent disk, not inside a Drive-synced folder.
KOSH_STORAGE_RECONCILIATION_ROOT=.kosh/reconciliation

# Distributed quota reservations.
KOSH_STORAGE_RESERVATION_TTL_MINUTES=120

# PostgreSQL is required for distributed reservations in production.
WORKSPACE_DATABASE_URL=
