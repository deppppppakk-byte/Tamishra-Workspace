# Self-hosted / cache Kosh Node
# Copy this file to .env.kosh-node and replace all CHANGE_ME values locally.
# Never commit .env.kosh-node.

NODE_ENV=production
WORKSPACE_CORE_ONLY=true
WORKSPACE_GATEWAY_PORT=4100

# Use the same PostgreSQL/Neon database as the Kosh metadata service.
WORKSPACE_DATABASE_URL=CHANGE_ME_DATABASE_URL

# Browser origins allowed to call the node through the Tamishra reverse proxy.
WORKSPACE_ALLOWED_ORIGINS=https://tamishra.in,https://www.tamishra.in,https://kosh.tamishra.in
WORKSPACE_IP_HASH_SECRET=CHANGE_ME_32_PLUS_CHAR_SECRET
WORKSPACE_SESSION_COOKIE_SECURE=true
WORKSPACE_SESSION_COOKIE_PATH=/api/workspace

# Public URLs always remain Tamishra/Kosh URLs even though this process may run
# on a cloud instance or a disposable local cache node.
KOSH_PUBLIC_ORIGIN=https://tamishra.in/kosh

# Online-native repository persistence. PostgreSQL snapshots are authoritative;
# local Git directories are disposable caches reconstructed from those snapshots.
# Generation compare-and-swap prevents an older cache from overwriting a newer
# online repository state.
KOSH_REPO_PERSISTENCE=postgres
KOSH_REPO_AUTHORITY=online
KOSH_REPO_SNAPSHOT_MAX_MB=512

# Disposable/local Git cache root. It can be reconstructed from online snapshots.
KOSH_REPO_ROOT=C:/Kosh/data/repos

# Repositories that must exist when the node starts.
KOSH_BOOTSTRAP_REPOSITORIES=tamishra/kavyn-2d,tamishra/os
KOSH_BOOTSTRAP_SINGLE_OWNER_FALLBACK=true

# Long random secrets used by Git/runner authentication.
KOSH_GIT_TOKEN=CHANGE_ME_24_PLUS_CHAR_SECRET
KOSH_RUNNER_TOKEN=CHANGE_ME_24_PLUS_CHAR_SECRET

# Optional native storage verification can remain disabled for the first node.
KOSH_NATIVE_STORAGE_SELFTEST=false

# Active/passive cache failover. Keep PRIMARY on the normal cache host. A standby
# computer uses STANDBY and does not start the public tunnel until promoted.
# This is now a recovery layer; it is no longer the durable repository authority.
KOSH_NODE_ROLE=PRIMARY
KOSH_PRIMARY_HEALTH_URL=https://tamishra.in/kosh/health
KOSH_FAILOVER_OFFLINE_CONFIRMATIONS=6
KOSH_FAILOVER_OFFLINE_INTERVAL_SECONDS=10

# Optional replicated offline backup destination/source.
KOSH_FAILOVER_SYNC_ROOT=
