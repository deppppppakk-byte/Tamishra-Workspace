{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/kosh/:path*",
      "destination": "https://tamishra.in/api/kosh/:path*"
    },
    {
      "source": "/workspace",
      "destination": "/"
    },
    {
      "source": "/workspace/:path*",
      "destination": "/:path*"
    }
  ]
}
