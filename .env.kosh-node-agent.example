# Kosh Node Agent
# Copy to a private local env file. Never commit real secrets.

KOSH_CLOUD_CONTROLLER_URL=https://tamishra.in/kosh/v1/kosh/cloud
KOSH_CLOUD_NODE_ENROLLMENT_SECRET=CHANGE_ME_32_PLUS_CHAR_SECRET

KOSH_NODE_NAME=CHANGE_ME_NODE_NAME
KOSH_NODE_REGION=local
KOSH_NODE_TOTAL_SLOTS=2

# Optional public/reverse-proxy URL for this node. Leave empty if the node is
# reachable only through another private Kosh routing layer.
KOSH_NODE_PUBLIC_URL=

# The built-in node reverse proxy is loopback-only by default. Set 0.0.0.0 only
# when another trusted reverse proxy or firewall protects the port.
KOSH_NODE_PROXY_HOST=127.0.0.1
KOSH_NODE_PROXY_PORT=8080

KOSH_NODE_POLL_MS=5000
KOSH_NODE_HEARTBEAT_MS=15000
# Windows example: C:/Kosh/node-agent
# Linux example: /var/lib/kosh/node-agent
KOSH_NODE_STATE_DIR=
